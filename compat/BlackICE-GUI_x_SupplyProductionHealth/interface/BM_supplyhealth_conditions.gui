# compat: Better Mechanics Supply Production Health indicator placed in the BlackICE GUI
# divisions slot (topbar row 1), styled like the other BlackICE topbar slots
guiTypes = {
	containerWindowType = {
		name = "RCM_supply_conditions_container"
		position = { x = 0 y = 0 }
		size = { width = 102%% height = 107%% }

		containerWindowType = {
			name = "RCM_supply_conditions_container_2"
			position = { x = 411 y = 8 }
			size = { width = 95 height = 28 }

			iconType = {
				name ="supply_overlay"
				spriteType = "GFX_supply_overlay"
				position = { x = 10 y = -1 }
				Orientation = "UPPER_LEFT"
				scale = 0.75
				pdx_tooltip = "SUPPLY_CONDITION_TOOLTIP"
			}

			# filled by the scripted GUI from supply_condition (0-100), fuel/convoys bar stretched to end where the bars below end
			iconType = {
				name = "supply_ratio_bar"
				spriteType = "GFX_compat_supply_health_bar"
				position = { x = 32 y = 14 }	# same height as the factory bar
				frame = 50
				alwaystransparent = yes
			}

			instantTextboxType = {
				name = "supply"
				position = { x = 31 y = -4 }
				font = "hoi_20bs"
				text = "SUPPLY_DISPLAY_TOOLTIP"
				maxWidth = 59
				maxHeight = 24
				format = centre
				pdx_tooltip = "SUPPLY_CONDITION_TOOLTIP"
			}
		}
	}
}
